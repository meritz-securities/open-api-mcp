# 메리츠증권 Open API 자격증명
#
#   cp .env.example .env && chmod 600 .env
#
# 서버가 저장소 루트의 .env 를 자동으로 읽습니다.
# 이미 설정된 환경변수가 .env 보다 우선하므로, MCP 클라이언트 설정에
# env 를 남겨 두셨다면 그쪽 값이 쓰입니다.
# 값을 바꾸신 뒤에는 클라이언트를 다시 시작해 주세요.
#
# 앱키에는 계좌가 묶여 있습니다. 키가 다르면 클라이언트마다 다른 계좌를 보게 됩니다.

MERITZ_APP_KEY=
MERITZ_APP_SECRET=

# ── 호출 대상 서버 ────────────────────────────────────────────────
# 기본값은 운영 서버(https://openapi.imeritz.com:9443)입니다.
# 다른 서버로 붙이셔야 한다면 주소를 직접 넣어 주세요(https 만 허용).
# 실시간(웹소켓) 주소는 따로 지정해야 합니다.
#
# MERITZ_BASE_URL=
# MERITZ_WS_URL=

# ── 안전 스위치 ───────────────────────────────────────────────────
# 기본이 조회 전용(1)입니다. 주문·환전을 쓰시려면 0 으로 두십시오.
# MERITZ_READ_ONLY=0

# 요청 제한시간(초). 기본 15
# MERITZ_TIMEOUT=15
