{
  "manifest_version": "0.2",
  "name": "meritz-open-api",
  "display_name": "메리츠증권 Open API",
  "version": "0.3.0",
  "description": "메리츠증권 계좌의 시세·잔고·주문을 대화로 다룹니다.",
  "long_description": "시세와 잔고를 조회하고 주문을 낼 수 있습니다. 실제 계좌에 영향을 주므로, 처음에는 조회 전용으로 두시고 필요할 때만 주문을 열어 주십시오. 주문은 보낼 내용을 먼저 보여드린 뒤 확인을 받아야 전송됩니다.",
  "author": { "name": "메리츠증권" },
  "homepage": "https://github.com/meritz-securities/open-api-mcp",
  "documentation": "https://github.com/meritz-securities/open-api-mcp#readme",
  "license": "MIT",
  "privacy_policies": ["https://github.com/meritz-securities/open-api-mcp/blob/main/DISCLAIMER.md"],
  "keywords": ["meritz", "open-api", "trading", "stock", "korea"],
  "server": {
    "type": "python",
    "entry_point": "meritz/server.py",
    "mcp_config": {
      "command": "uvx",
      "args": ["--from", "${__dirname}", "meritz-mcp"],
      "env": {
        "MERITZ_APP_KEY": "${user_config.app_key}",
        "MERITZ_APP_SECRET": "${user_config.app_secret}",
        "MERITZ_READ_ONLY": "${user_config.read_only}"
      }
    }
  },
  "user_config": {
    "app_key": {
      "type": "string",
      "title": "App Key",
      "description": "개발자 포털에서 발급받은 앱키입니다.",
      "required": true,
      "sensitive": true
    },
    "app_secret": {
      "type": "string",
      "title": "App Secret",
      "description": "앱키와 함께 발급받은 시크릿입니다.",
      "required": true,
      "sensitive": true
    },
    "read_only": {
      "type": "boolean",
      "title": "조회 전용으로 사용",
      "description": "켜 두면 주문과 환전이 전송되지 않습니다. 조회만 하실 때는 켜 두시길 권합니다.",
      "default": true,
      "required": false
    }
  },
  "tools": [
    { "name": "meritz_account", "description": "잔고·예수금·평가·거래내역" },
    { "name": "meritz_market", "description": "국내주식 시세·호가·체결" },
    { "name": "meritz_overseas_market", "description": "해외주식 시세·호가·체결" },
    { "name": "meritz_trading", "description": "주문·정정·취소·주문내역" },
    { "name": "meritz_forex", "description": "환율·환전" },
    { "name": "meritz_reference", "description": "거래소 등 참조 정보" },
    { "name": "meritz_info", "description": "서버 설정과 카탈로그 요약" }
  ],
  "compatibility": { "runtimes": { "python": ">=3.11" } }
}
